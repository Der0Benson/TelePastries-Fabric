{
  "schemaVersion": 1,
  "id": "telepastries",
  "version": "${version}",
  "name": "TelePastries Fabric",
  "description": "Inoffizielle Fabric-Portierung von TelePastries: Kuchen für sichere Reisen zwischen Dimensionen.",
  "authors": [
    "Mrbysco",
    "ShyNieke"
  ],
  "contributors": [
    "Ben Luca Pritzsche"
  ],
  "contact": {
    "homepage": "https://github.com/Der0Benson/TelePastries-Fabric",
    "sources": "https://github.com/Der0Benson/TelePastries-Fabric",
    "issues": "https://github.com/Der0Benson/TelePastries-Fabric/issues"
  },
  "license": "MIT",
  "icon": "assets/telepastries/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mrbysco.telepastries.TelePastries"
    ]
  },
  "mixins": [
    "telepastries.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "twilightforest": "*",
    "lostcities": "*"
  }
}
